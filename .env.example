# Reference only: bloc reads process environment; it does not load .env files.
BLOC_BIND_ADDR=127.0.0.1:3000
RUST_LOG=info
# Required; files must be provisioned by the operator.
BLOC_DATABASE_URL_FILE=/run/bloc/runtime-url
BLOC_DATABASE_CA_FILE=/run/bloc/ca.crt
BLOC_ABUSE_KEY_FILE=/run/bloc/abuse-key
BLOC_CANONICAL_ORIGIN=https://bloc.example.test
BLOC_TRUSTED_PROXY_CIDRS=127.0.0.1/32
